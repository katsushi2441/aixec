{
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "strategy", "actions", "success_metrics", "memory_note"],
  "properties": {
    "summary": {"type": "string"},
    "strategy": {"type": "string"},
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "priority", "reason"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["market_registration", "sns_post", "content_idea", "observe_only"]
          },
          "priority": {"type": "integer", "minimum": 1, "maximum": 5},
          "reason": {"type": "string"},
          "limit": {"type": "integer", "minimum": 1, "maximum": 500},
          "topic": {"type": "string"},
          "message": {"type": "string"}
        }
      }
    },
    "success_metrics": {
      "type": "array",
      "items": {"type": "string"}
    },
    "memory_note": {"type": "string"}
  }
}

